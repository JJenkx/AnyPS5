enable_language(C)
function(add_http_transport_dependencies)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    set(ENABLE_TESTING OFF)
    set(ENABLE_PROGRAMS OFF)
    set(MBEDTLS_FATAL_WARNINGS OFF)
    set(USE_SHARED_MBEDTLS_LIBRARY OFF)
    set(USE_STATIC_MBEDTLS_LIBRARY ON)
    add_subdirectory(${CMAKE_SOURCE_DIR}/3rdparty/mbedtls ${CMAKE_BINARY_DIR}/3rdparty/mbedtls EXCLUDE_FROM_ALL)
    set(ZLIB_BUILD_TESTING OFF)
    set(ZLIB_BUILD_SHARED OFF)
    set(ZLIB_BUILD_STATIC ON)
    set(ZLIB_INSTALL OFF)
    add_subdirectory(${CMAKE_SOURCE_DIR}/3rdparty/zlib ${CMAKE_BINARY_DIR}/3rdparty/zlib EXCLUDE_FROM_ALL)
    add_library(ZLIB::ZLIB ALIAS zlibstatic)
    set(ZLIB_INCLUDE_DIR ${CMAKE_SOURCE_DIR}/3rdparty/zlib)
    set(ZLIB_LIBRARY zlibstatic)
    set(MBEDTLS_INCLUDE_DIR ${CMAKE_SOURCE_DIR}/3rdparty/mbedtls/include)
    set(MBEDTLS_LIBRARY mbedtls)
    set(MBEDX509_LIBRARY mbedx509)
    set(MBEDCRYPTO_LIBRARY mbedcrypto)
    set(BUILD_TESTING OFF)
    set(BUILD_CURL_EXE OFF)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(CURL_DISABLE_INSTALL ON)
    set(CURL_ENABLE_EXPORT_TARGET OFF)
    set(CURL_USE_PKGCONFIG OFF)
    set(CURL_USE_CMAKECONFIG OFF)
    set(CURL_USE_OPENSSL OFF)
    set(CURL_USE_MBEDTLS ON)
    set(CURL_USE_LIBPSL OFF)
    set(USE_LIBIDN2 OFF)
    set(CURL_USE_LIBSSH2 OFF)
    set(CURL_USE_LIBSSH OFF)
    set(CURL_USE_GSSAPI OFF)
    set(USE_NGHTTP2 OFF)
    set(CURL_BROTLI OFF)
    set(CURL_ZSTD OFF)
    set(CURL_ZLIB ON)
    set(HTTP_ONLY ON)
    set(CURL_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt)
    set(CURL_CA_PATH /etc/ssl/certs)
    add_subdirectory(${CMAKE_SOURCE_DIR}/3rdparty/curl ${CMAKE_BINARY_DIR}/3rdparty/curl EXCLUDE_FROM_ALL)
endfunction()
add_http_transport_dependencies()

install(FILES ${CMAKE_SOURCE_DIR}/3rdparty/curl/COPYING DESTINATION licenses/curl)
install(FILES ${CMAKE_SOURCE_DIR}/3rdparty/mbedtls/LICENSE DESTINATION licenses/mbedtls)
install(FILES ${CMAKE_SOURCE_DIR}/3rdparty/zlib/LICENSE DESTINATION licenses/zlib)
